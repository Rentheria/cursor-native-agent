# cursor-native-agent — safe defaults for a fresh clone.
# These values work out of the box for local dev. Copy to `.env` to override.
# Shell exports win over both files (never overridden).
# `.env` is gitignored; this file is the template (committed).

# --- Cursor CLI binary -------------------------------------------------------
# Absolute path when PATH does not include the install (systemd, IDE launchers).
# Default: autodetect ~/.local/bin/cursor-agent, then bare `cursor-agent` on PATH.
# CURSOR_AGENT_BIN_PATH=/home/you/.local/bin/cursor-agent

# --- Cursor CLI model --------------------------------------------------------
# Model pinning for cursor-agent. When set and not empty/auto, passes --model <id>.
# Demo default: Composer 2.5 Fast (tono consistente para meetup en vivo).
# Set to "auto" or leave empty to use cursor-agent CLI default (Auto model selection).
# Override in shell or .env to try another model (cursor-agent models para IDs).
CURSOR_AGENT_MODEL=composer-2.5-fast

# --- Dashboard ---------------------------------------------------------------
# HTTP listen port. Bound to 127.0.0.1 only.
PORT=3847

# Chat UI + POST /api/chat. Enabled by default for local use.
# Set to 0 / false / off for read-only (observe-only) dashboard.
CURSOR_NATIVE_AGENT_DASHBOARD_CHAT=1

# --- CLI / debug -------------------------------------------------------------
# Verbose agent turn logging (same as --debug). Off by default.
# CURSOR_NATIVE_AGENT_DEBUG=0

# --- Workspace path ----------------------------------------------------------
# Absolute path where user projects are built. Default: ~/Documents/cursor-native-agent
# or ~/Documentos/cursor-native-agent (Spanish locales). Set during first-run onboarding.
# WORKSPACE_PATH=

# --- Semantic memory (local TF-IDF by default) -------------------------------
# Semantic fallback for memory loading (keyword-only when off).
CURSOR_NATIVE_AGENT_SEMANTIC_MEMORY=1

# Max semantic detail files loaded in addition to keyword matches.
CURSOR_NATIVE_AGENT_SEMANTIC_TOP_K=3

# Minimum cosine/TF-IDF similarity to accept a semantic hit.
CURSOR_NATIVE_AGENT_SEMANTIC_THRESHOLD=0.12

# Embeddings backend: local | tfidf | custom.
CURSOR_NATIVE_AGENT_EMBEDDINGS_PROVIDER=local

# ESM module path when PROVIDER=custom (required for custom).
# CURSOR_NATIVE_AGENT_EMBEDDINGS_MODULE=

# --- Telegram channel (optional) ---------------------------------------------
# Bot token from BotFather. NEVER commit a real token. Never expose to the
# dashboard HTML/JS — server-side only.
# REQUIRED to start telegram bot; no default.
# TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs allowed to reach cursor-agent.
# REQUIRED to start telegram bot; no default. Fails closed without this.
# TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: further restrict by Telegram user id.
# TELEGRAM_ALLOWED_USER_IDS=

# --- Cron scheduling (optional) ----------------------------------------------
# Schedule for `npm run cron:install` (cron syntax).
# Default: weekdays at 9:00 AM (0 9 * * 1-5).
# Examples:
#   Every 30 minutes:  */30 * * * *
#   Every hour:        0 * * * *
#   Daily at 6:00 AM:  0 6 * * *
# CURSOR_NATIVE_AGENT_CRON_SCHEDULE=0 9 * * 1-5

